{
  "name": "stet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Refund-decision agent that applies a shop's plain-English policy exactly, on OpenServ SERV Reasoning.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "node --env-file=.env eval/run.js",
    "probe": "node --env-file=.env probe/serv-probe.js",
    "local": "vite build && node --env-file=.env scripts/local-server.js"
  },
  "dependencies": {
    "@openserv-labs/sdk": "^2.2.0",
    "openai": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "svelte": "^5.1.9",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "MIT"
}
