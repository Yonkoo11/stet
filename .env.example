# Stet settings. Copy this file to .env and fill in the values you have.
# .env is ignored by git and must never be committed or pasted anywhere.
# Leave a line blank if you don't have that key yet; Stet falls back where it can.

# SERV Reasoning (OpenServ). Create at console.openserv.ai.
# Also turn on data collection at console.openserv.ai/settings/organization (the hackathon requires it).
SERV_API_KEY=

# Optional: override the SERV model. Default: gemini-3.5-flash-lite-serv-kronos-multipath
SERV_MODEL=

# The SERV-off comparison engine (Gemini direct). Create at aistudio.google.com.
GEMINI_API_KEY=

# Optional: the base model used on both engines. Default: gemini-3.5-flash-lite
STET_BASE_MODEL=

# Only used if GEMINI_API_KEY is empty.
OPENAI_API_KEY=

# Telegram bot (optional). Token from @BotFather; the secret is any long random string
# you also pass to Telegram's setWebhook as secret_token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# The shop's policy and orders for the Telegram bot (optional).
STET_POLICY=
STET_ORDERS_JSON=

# OpenServ platform agent (optional). platform.openserv.ai -> Developer -> Your Agents -> Create Secret Key.
OPENSERV_API_KEY=

# Optional: public demo rate limit per visitor per minute. Default: 10
STET_RATE_PER_MIN=
